PORT=5000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Tryb ciasteczek sesji: off (tylko Bearer), dual (Bearer + httpOnly cookie), only (tylko httpOnly cookie)
AUTH_COOKIE_MODE=off

# SSRF guard dla webhooków: 1 = blokuj cele prywatne (localhost, 10.x, 192.168.x, 172.16-31.x, .local); 0 = zezwalaj
WEBHOOK_BLOCK_PRIVATE=1

# MS SQL (ERP) - leave MSSQL_SERVER empty to use mock data
MSSQL_SERVER=
MSSQL_PORT=1433
MSSQL_DATABASE=ERP
MSSQL_USER=
MSSQL_PASSWORD=